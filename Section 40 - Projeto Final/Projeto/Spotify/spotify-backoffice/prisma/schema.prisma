generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//nomes seguindo PascalCase, ex: UserInfo
model Band { // --> Band
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  status Status @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  //Nomes no plural seguindo snake_case. Ex: user_infos
  @@map("bands")
}

model Track {
  id String @id @default(uuid()) @db.Uuid
  title String 
  slug String @unique
  duration Int  // Duração em segundos
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tracks")
}

enum Status {
  active
  inactive
}